PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/brainwave
AI_PROVIDER=unconfigured
# Used when AI_PROVIDER=bedrock. Authentication uses the standard AWS credential chain.
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=
AI_TIMEOUT_MS=30000
API_BASE_URL=http://localhost:3000
CLIENT_URL=http://localhost:5173
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Generate with: openssl rand -base64 32
OAUTH_TOKEN_ENCRYPTION_KEY=
SESSION_TTL_MS=2592000000
# Development/test only. The server refuses to start if enabled in production.
AUTH_BYPASS=true
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
# Optional deterministic selection when a grant exposes multiple sites.
JIRA_CLOUD_ID=
JIRA_TIMEOUT_MS=10000
